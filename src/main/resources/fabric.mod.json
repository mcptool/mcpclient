{
	"schemaVersion": 1,
	"id": "mcpclient",
	"version": "${version}",
	"name": "MCPClient",
	"description": "Official Minecraft client from MCPTool (Fabric)",
	"authors": [
		"wRRulosDEV"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mcpclient/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.wrrulosdev.mcpclient.MCPClientMain"
		],
		"client": [
			"dev.wrrulosdev.mcpclient.client.MCPClient"
		]
	},
	"mixins": [
		"mcpclient.mixins.json",
		{
			"config": "mcpclient.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}